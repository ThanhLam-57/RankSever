{
  "openapi": "3.0.1",
  "info": {
    "title": "RankServer",
    "version": "1.0"
  },
  "paths": {
    "/api/rank/update": {
      "post": {
        "tags": [
          "Rank"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchResultListRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchResultListRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MatchResultListRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rank/weekly/point": {
      "get": {
        "tags": [
          "Rank"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rank/weekly/kill": {
      "get": {
        "tags": [
          "Rank"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rank/monthly/point": {
      "get": {
        "tags": [
          "Rank"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rank/monthly/kill": {
      "get": {
        "tags": [
          "Rank"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rank/me/{tikTokUserId}": {
      "get": {
        "tags": [
          "Rank"
        ],
        "parameters": [
          {
            "name": "tikTokUserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MatchResultListRequest": {
        "type": "object",
        "properties": {
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchResultRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MatchResultRequest": {
        "type": "object",
        "properties": {
          "tikTokUserId": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "matchPoint": {
            "type": "integer",
            "format": "int32"
          },
          "killCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}